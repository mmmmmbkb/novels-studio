# ── استوديو الروايات — متغيرات البيئة ─────────────────────────────────
# انسخ هذا الملف إلى .env.local محليًا، وأضف نفس القيم في Vercel:
# Project → Settings → Environment Variables
# ⚠️ لا تضع أي مفتاح حقيقي في الكود أو في Git أبدًا.

# --- Supabase (إلزامي للوضع الحقيقي متعدد المستخدمين) ---
# من: https://supabase.com/dashboard → مشروعك → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...PASTE-YOUR-ANON-KEY-HERE
# مفتاح الخدمة (Service Role) — للسيرفر فقط، لا يبدأ بـ NEXT_PUBLIC_ أبدًا:
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...PASTE-YOUR-SERVICE-ROLE-KEY-HERE

# --- الأدمن (محمود، أدمن جروب ميراكس) ---
# الإيميل الذي يُمنح دور أدمن تلقائيًا عند أول تسجيل دخول:
NEXT_PUBLIC_ADMIN_EMAIL=mahmoud@example.com

# --- فيسبوك (اختياري — تسجيل دخول + ربط بروفايل فقط) ---
# يُضبط داخل Supabase: Authentication → Providers → Facebook
# ويحتاج تطبيقًا في Meta for Developers (انظر README القسم 4).
# ملاحظة مهمة: Groups API أُلغي من Meta في 22 أبريل 2024، فلا يوجد
# تحقق تلقائي من عضوية الجروب ولا نشر آلي فيه عبر API.
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_GROUP_ID=918194596679289
NEXT_PUBLIC_GROUP_URL=https://www.facebook.com/groups/918194596679289/

# --- وضع التشغيل ---
# اتركه فارغًا: التطبيق يعمل في «الوضع المحلي» (localStorage) إذا لم
# تُضبط متغيرات Supabase، ويتحول تلقائيًا للوضع الحقيقي عند ضبطها.
# NEXT_PUBLIC_DEMO_MODE=true
